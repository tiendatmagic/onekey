<!DOCTYPE html>
<html
  font-size="16px"
   <% if ( platform === 'ext' && filename === 'ui-popup.html' ) { %>
      style="min-height: 600px; min-width: 400px; margin: 0; overflow: auto;"
   <% } %>
>
  <head>
    <meta charset="utf-8" />
    <meta httpEquiv="X-UA-Compatible" content="IE=edge" />
    <!--
        This viewport works for phones with notches.
        It's optimized for gestures by disabling global zoom.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1.00001, viewport-fit=cover"
    />
    <title>CC Wallet</title>
    <meta name="theme-color" content="#ffffff" />
    <style>
      /* add global styles to packages/shared/src/web/index.css */
    </style>

    <% if (typeof onekeyBootstrapDataCode !== 'undefined' && onekeyBootstrapDataCode) { %>
    <script>
      <%= onekeyBootstrapDataCode %>
    </script>
    <% } %>

    <% if ( (platform === 'desktop' || platform === 'web') && isDev ) { %>
    <script>
      // DEV-ONLY (gated by isDev — ZERO prod effect): pre-read the context
      // atom snapshot from IndexedDB HERE, during HTML parse, while the main
      // thread is still free.
      //
      // WHY: the read costs ~1.5s when it happens during the boot JS storm (its
      // onsuccess callback is starved by jotaiInit / React / render work), but
      // only ~3ms pre-bundle. AND hydrate.ts keeps the generic context-atom
      // hydration off in dev, to avoid schema drift between code changes. This
      // pre-read fills the UI snapshot map with one record — NOT the
      // `__ONEKEY_CTX_ATOM_SNAPSHOT__` global — so the self-contained,
      // currency-gated, provisional SLC token-list slim cold start activates in
      // dev for local verification. Prod keeps its real hydrate.ts path.
      (function () {
        try {
          var DBN = 'onekey-ui-snapshot';
          // The record as its namespace stores it; the cache layer in the
          // bundle parses and age-checks it.
          var KEYS = ['ctx-atom-snapshot:d:v1'];
          navigator.storageBuckets
            .open(DBN, { persisted: true, durability: 'strict' })
            .then(function (bk) {
              return new Promise(function (res, rej) {
                var r = bk.indexedDB.open(DBN, 1);
                r.onupgradeneeded = function () {
                  try { r.result.createObjectStore('records'); } catch (e) {}
                };
                r.onsuccess = function () { res(r.result); };
                r.onerror = function () { rej(r.error); };
              });
            })
            .then(function (db) {
              return new Promise(function (res, rej) {
                var tx = db.transaction('records', 'readonly');
                var store = tx.objectStore('records');
                var remaining = KEYS.length;
                var entries = [];
                var done = function () {
                  remaining -= 1;
                  if (remaining === 0) {
                    try { db.close(); } catch (e) {}
                    res(entries);
                  }
                };
                KEYS.forEach(function (key) {
                  var req = store.get(key);
                  req.onsuccess = function () {
                    entries.push({ key: key, value: req.result });
                    done();
                  };
                  req.onerror = function () { rej(req.error); };
                });
              });
            })
            .then(function (entries) {
              var g = globalThis;
              var map = g.__ONEKEY_UI_SNAPSHOT_MAP__;
              if (!map) { map = new Map(); g.__ONEKEY_UI_SNAPSHOT_MAP__ = map; }
              entries.forEach(function (entry) {
                if (typeof entry.value !== 'string') return;
                // Do NOT clobber a value a write may already have set.
                if (!map.has(entry.key)) map.set(entry.key, entry.value);
              });
            })
            .catch(function () { /* best-effort: no cold paint, no harm */ });
        } catch (e) { /* storageBuckets unsupported -> no-op */ }
      })();
    </script>
    <% } %>

      <% if ( (platform === 'desktop' || platform === 'web-embed') && !isDev && typeof releaseMetaUrl !== 'undefined' ) { %>
          <script defer src="<%= releaseMetaUrl %>"></script>
      <% } %>
      <% if ( platform === 'ext' ) { %>
      <% if ( !isDev ) { %>
          <script src="/release-meta.js"></script>
      <% } %>
      <!--    <script>-->
      <!--      // ** inline script not allowed in Ext, use themePreload.js instead-->
      <!--    </script>-->
          <script src="/preload-html-head.js?<%= currentVersion %>"></script>
      <% } %>

      <% if ( platform === 'desktop' || platform === 'web' ) { %>
          <script>
// >>>>>>> automatic copy code from preload-html-head.js <<<<<<<<<
            <%= htmlHeadPreloadCode %>
          </script>
      <% } %>
      <% if ( platform === 'web' ) { %>
        <script>
          // Referral invite links (/r/<code>/...) offer the App Clip card in
          // iOS Safari. The banner meta is read from the parsed head, so it is
          // added here, during parsing, and only on referral paths: every web
          // route shares this template, and the App Clip only handles /r/ and
          // /clip/ URLs. IDs match the App Store listing and the App Clip target.
          (function () {
            // Same shapes as the App Clip's referral parser:
            // /r/<code>, /r/<code>/app and /r/<code>/app/<page>.
            if (
              !/^\/r\/[A-Za-z0-9_-]{1,32}(\/app(\/[A-Za-z0-9_-]{0,32})?)?\/?$/.test(
                location.pathname
              )
            ) {
              return;
            }
            var meta = document.createElement('meta');
            meta.name = 'apple-itunes-app';
            meta.content =
              'app-id=1609559473, app-clip-bundle-id=so.onekey.wallet.Clip, app-clip-display=card';
            document.head.appendChild(meta);
          })();
        </script>
      <% } %>
      <% if ( platform == 'web-embed' ) { %>
        <script>
          if (typeof globalThis === 'undefined') {
              var globalThis = window;
          }
        </script>
      <% } %>
      <% if ( platform !== 'ext' ) { %>
        <script>
          if (typeof window.$$onekeyStartupTimeAt === 'undefined') {
            window.$$onekeyStartupTimeAt = Date.now();
          }
        </script>
      <% } %>
  </head>

  <!-- html template copy from node_modules/@expo/webpack-config/web-default/index.html -->
  <body class="onekey-body"

        data-platform="<%= platform %>"
        data-browser="<%= browser %>"
        data-filename="<%= filename %>-not-correct-in-ext"
    <% if ( platform === 'ext' && browser === 'firefox' && filename === 'ui-popup.html' ) { %>
        style="min-height: 600px; min-width: 400px; margin: 0;"
    <% } %>
  >

    <!--
      A generic no script element with a reload button and a message.
      Feel free to customize this however you'd like.
    -->
    <noscript>
      <form
        action=""
        style="
          background-color: #fff;
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 9999;
        "
      >
        <div
          style="
            font-size: 18px;
            font-family: Helvetica, sans-serif;
            line-height: 24px;
            margin: 10%;
            width: 80%;
          "
        >
          <p>Oh no! It looks like JavaScript is not enabled in your browser.</p>
          <p style="margin: 20px 0">
            <button
              type="submit"
              style="
                background-color: #4630eb;
                border-radius: 100px;
                border: none;
                box-shadow: none;
                color: #fff;
                cursor: pointer;
                font-weight: bold;
                line-height: 20px;
                padding: 6px 16px;
              "
            >
              Reload
            </button>
          </p>
        </div>
      </form>
    </noscript>

    <!-- The root element for your Expo app.  -->
    <div id="root">
      <% if ( platform == 'web-embed' ) { %> 
        <!-- webEmbed index.html -->
      <% } %>
    </div>

    <% if ( platform !== 'ext' ) { %>
      <script>
        (()=>{
          const rootElement = document.getElementById('root');
          if (rootElement) {
            rootElement.setAttribute('data-html-render-time', Date.now().toString());
          }
        })();
      </script>
    <% } %>

    <% if ( platform !== 'web-embed' && platform !== 'web' ) { %>
      <img
        width='80'
        class="onekey-index-html-preload-image"
        style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%)"
        src="data:image/png;base64,"
      />
    <% } %>
  </body>
</html>
